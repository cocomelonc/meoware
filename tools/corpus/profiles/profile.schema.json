{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Meoware corpus profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "groups"],
  "properties": {
    "schema_version": {"const": 1, "type": "integer"},
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "groups": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"$ref": "#/$defs/group"}}
  },
  "$defs": {
    "size": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "group": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "format", "directory", "count", "content_bytes", "content"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$"},
        "format": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "directory": {"type": "string", "minLength": 1, "maxLength": 120},
        "count": {"type": "integer", "minimum": 1, "maximum": 100000},
        "copies": {"type": "integer", "minimum": 1, "maximum": 1000, "default": 1},
        "content": {"enum": ["text", "repeat", "random", "zeros", "mixed"]},
        "text": {"type": "string", "pattern": "^[ -~]{1,4096}$"},
        "content_bytes": {"oneOf": [
          {"type": "array", "minItems": 1, "maxItems": 10000, "items": {"$ref": "#/$defs/size"}},
          {"type": "object", "additionalProperties": false, "required": ["min", "max"],
           "properties": {"min": {"$ref": "#/$defs/size"}, "max": {"$ref": "#/$defs/size"}}}
        ]}
      }
    }
  }
}
